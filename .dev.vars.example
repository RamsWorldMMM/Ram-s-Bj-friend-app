# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
AUTH_SECRET="generate-with-openssl-rand-base64-32"

# Set MOCK_LLM=1 to exercise the full pipeline without calling Vertex AI.
MOCK_LLM="1"

# Real Vertex AI usage (set MOCK_LLM=0 first):
# GCP_PROJECT_ID="your-gcp-project-id"
# VERTEX_LOCATION="us-central1"
# VERTEX_MODEL="gemini-2.5-flash"
# GCP_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...","token_uri":"https://oauth2.googleapis.com/token"}'
